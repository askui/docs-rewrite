# AskUI hub credentials used by the CLI for the capture run.
# Copy this file to .env and fill in real values (or use `op run`).
ASKUI_WORKSPACE_ID=your-workspace-id
ASKUI_TOKEN=your-access-token

# Where the app repo checkout lives (holds AskUI.Cli). Optional — the driver
# probes the known sibling layouts when unset.
APP_REPO=/path/to/integrated-task-plattform

# The display the AskUI Desktop app is visible on. Optional, default 1.
CAPTURE_DISPLAY=1
